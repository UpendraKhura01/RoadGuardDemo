# ============================================
# RoadGuard Frontend - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# ============================================
# Backend API Configuration
# ============================================
# Backend API base URL
# For local development:
# - Web/Desktop: http://localhost:8080/roadguard/v1
# - Android emulator: http://10.0.2.2:8080/roadguard/v1
# - iOS simulator: http://localhost:8080/roadguard/v1
# For production: https://your-api-domain.com/roadguard/v1
API_BASE_URL=http://localhost:8080/roadguard/v1

# ============================================
# Google Maps Configuration
# ============================================
# Google Maps API Key for map display
# Get your API key from: https://developers.google.com/maps/documentation/javascript/get-api-key
# Enable these APIs for your key:
# - Maps JavaScript API
# - Places API
# - Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ============================================
# App Configuration
# ============================================
# App environment (development, staging, production)
APP_ENVIRONMENT=development

# Enable debug mode (shows additional logs)
DEBUG_MODE=true
